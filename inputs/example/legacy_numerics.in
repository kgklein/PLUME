! Historical numerical controls; same physical plasma as faddeeva_accuracy.in.
! Warm proton/electron Alfven/ion-cyclotron branch; omega ~0.061-1.3e-5i.
&params
normalization='d_ref'
z_backend='legacy'
bessel_mode='fixed128'
betap=0.4
kpar=0.06
kperp=0.05
vtp=0.01
nspec=2
nscan=0
option=1
nroot_max=1
use_map=.false.
writeOut=.true.
collision_type=0
dataName='example'
outputName='legacy_numerics'
/
&species_1
tauS=0.4
muS=1.
alphS=1.3
Qs=1.
Ds=1.
vvS=0.
/
&species_2
tauS=0.2
muS=1836.
alphS=0.8
Qs=-1.
Ds=1.
vvS=0.
/
&guess_1
g_om=0.061
g_gam=-0.000013
/
