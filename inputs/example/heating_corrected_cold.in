! Stage 4B.3A: corrected collisionless heating and complete formal wave energy.
! Ex=1; cold kinetic heating is NaN. Energy components/statuses: heating_corrected_cold.energy
&params
heating_convention='corrected'
z_backend='faddeeva'
bessel_mode='adaptive'
bessel_diagnostics=.true.
bessel_nmax=1024
normalization='d_ref'
betap=0
kpar=0.059999999999999998
kperp=0.050000000000000003
vtp=0.01
nspec=2
nscan=1
option=1
nroot_max=1
use_map=.false.
writeOut=.true.
dataName='example'
outputName='heating_corrected_cold'

/
&species_1
tauS=0
muS=1
alphS=1
Qs=1
Ds=1
vvS=0
/
&species_2
tauS=0
muS=1836
alphS=0
Qs=-1
Ds=1
vvS=0
/
&guess_1
g_om=0.059999999999999998
g_gam=-0.0001
/
&scan_input_1
scan_style=0
scan_type=1
swi=0.059999999999999998
swf=0.065000000000000002
ns=2
nres=2
swlog=.false.
tensor=.false.
heating=.true.
eigen=.true.
/
