! Direct evaluation at an independently determined cold oblique eigenfrequency.
! Ex=1; prints E/B and cold-fluid species moments, with no energy, heating or FPC.
&params
z_backend='faddeeva'
bessel_mode='adaptive'
bessel_diagnostics=.true.
bessel_nmax=1024
normalization='d_ref'
betap=0
kpar=0.059999999999999998
kperp=0.050000000000000003
vtp=0.01
nspec=2
nscan=0
option=-1
nroot_max=1
use_map=.false.
writeOut=.true.
dataName='example'
outputName='cold_fields_single'

/
&species_1
tauS=0
muS=1
alphS=1
Qs=1
Ds=1
vvS=0
/
&species_2
tauS=0
muS=1836
alphS=0
Qs=-1
Ds=1
vvS=0
/
&guess_1
g_om=0.059722520021937162
g_gam=0
/
