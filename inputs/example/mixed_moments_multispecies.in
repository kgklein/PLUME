! Stage 4B.2: cold protons, warm electrons, warm and cold alpha components.
! Charge/current balanced; signed drift included. E/B and moments use Ex=1.
! No heating, wave energy or FPC.
&params
z_backend='faddeeva'
bessel_mode='adaptive'
bessel_diagnostics=.true.
bessel_nmax=1024
normalization='d_ref'
betap=0
kpar=0.059999999999999998
kperp=0.050000000000000003
vtp=0.01
nspec=4
nscan=1
option=1
nroot_max=1
use_map=.false.
writeOut=.true.
dataName='example'
outputName='mixed_moments_multispecies'

/
&species_1
tauS=0
muS=1
alphS=1
Qs=1
Ds=1
vvS=0
/
&species_2
tauS=0.20000000000000001
muS=1836
alphS=0.80000000000000004
Qs=-1
Ds=1.2
vvS=0.050000000000000003
/
&species_3
tauS=0.029999999999999999
muS=0.25
alphS=1.2
Qs=0.5
Ds=0.050000000000000003
vvS=0.29999999999999999
/
&species_4
tauS=0
muS=0.25
alphS=1
Qs=0.5
Ds=0.050000000000000003
vvS=0.29999999999999999
/
&guess_1
g_om=0.042999999999999997
g_gam=-2.0000000000000002e-05
/
&scan_input_1
scan_style=0
scan_type=1
swi=0.059999999999999998
swf=0.080000000000000002
ns=2
nres=2
swlog=.false.
tensor=.false.
heating=.false.
eigen=.true.
/
