! Same physical plasma as normalization_rho_ref.in; k is normalized to d_R.
&params
normalization='d_ref'
betap=0.4
kperp=0.05
kpar=0.06
vtp=0.0001
nspec=2
nscan=1
option=1
nroot_max=1
use_map=.false.
writeOut=.false.
dataName='example'
outputName='normalization_d_ref'
! Explicit runtime defaults.
heating_convention='corrected'
z_backend='faddeeva'
bessel_mode='adaptive'
bessel_tol=1.e-10
bessel_nmax=512
bessel_nfixed=128
bessel_diagnostics=.false.
low_n=.true.
collision_type=0
Kn=1.e30
warnings_to_stdout=.false.
/
&species_1
tauS=0.4
muS=1
alphS=1.5
Qs=1
Ds=1
vvS=0
/
&species_2
tauS=0.2
muS=1836
alphS=1
Qs=-1
Ds=1
vvS=0.0
/
&scan_input_1
scan_type=1
scan_style=0
swi=0.06
swf=0.6
swlog=.false.
ns=32
nres=1
heating=.true.
eigen=.true.
tensor=.true.
heating_gamma_ratio_max=0.05
/
&guess_1
g_om=0.01
g_gam=-0.001
/
