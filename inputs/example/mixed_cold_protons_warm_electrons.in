! Cold reference protons and warm electrons, oblique damped Alfven branch.
! Auxiliary scale is selected automatically; no thermal reference is supplied.
&params
normalization='d_ref'
betap=0
kpar=0.06
kperp=0.05
vtp=0.001
nspec=2
nscan=0
option=1
nroot_max=1
use_map=.false.
writeOut=.true.
collision_type=0
dataName='example'
outputName='mixed_cold_protons_warm_electrons'
/
&species_1
tauS=0
muS=1
alphS=0
Qs=1
Ds=1
vvS=0
/
&species_2
tauS=0.2
muS=1836
alphS=0.8
Qs=-1
Ds=1
vvS=0
/
&guess_1
g_om=0.05
g_gam=-0.001
/
