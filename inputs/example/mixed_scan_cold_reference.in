! Stage 4A: collisionless Alfven/ion-cyclotron continuation in k_parallel*d_ref.
! Positive, nonzero k_parallel; frequencies use omega/Omega_ref. No heating/eigenfunctions.
&params
z_backend='faddeeva'
bessel_mode='adaptive'
bessel_diagnostics=.true.
bessel_nmax=1024
normalization='d_ref'
betap=0
kpar=0.059999999999999998
kperp=0.050000000000000003
vtp=0.01
nspec=2
nscan=1
option=1
nroot_max=1
use_map=.false.
writeOut=.true.
dataName='example'
outputName='mixed_scan_cold_reference'

/
&species_1
tauS=0
muS=1
alphS=1
Qs=1
Ds=1
vvS=0
/
&species_2
tauS=0.20000000000000001
muS=1836.15267343
alphS=0.80000000000000004
Qs=-1
Ds=1
vvS=0
/
&guess_1
g_om=0.059999999999999998
g_gam=-0.0001
/
&scan_input_1
scan_style=0
scan_type=1
swi=0.059999999999999998
swf=0.10000000000000001
ns=8
nres=2
swlog=.false.
tensor=.false.
heating=.false.
eigen=.false.
/
